{
  "title": "Dia",
  "rules": [
    {
      "description": "Dia: Ctrl+J/K to Down/Up",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "j", "modifiers": { "mandatory": ["control"] } },
          "to": [{ "key_code": "down_arrow" }],
          "conditions": [
            { "type": "frontmost_application_if", "bundle_identifiers": ["^company\\.thebrowser\\.dia$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "k", "modifiers": { "mandatory": ["control"] } },
          "to": [{ "key_code": "up_arrow" }],
          "conditions": [
            { "type": "frontmost_application_if", "bundle_identifiers": ["^company\\.thebrowser\\.dia$"] }
          ]
        }
      ]
    }
  ]
}
